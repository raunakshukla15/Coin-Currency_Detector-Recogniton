# ============================================================
# CoinScan backend configuration
# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored — never commit real secrets.
#
# REQUIRED for all runs: MYSQL_* (database), JWT_SECRET
# REQUIRED for AI features (identify + chatbot): GEMINI_API_KEY
# OPTIONAL (Contact-form email delivery only): SMTP_* + CONTACT_TO
# OPTIONAL: JWT_EXPIRES_DAYS, APP_ENV, CORS_ORIGINS, GEMINI_MODEL,
#           GEMINI_API_URL (tests), SMTP_STARTTLS
# ============================================================

# --- Development configuration (defaults work for local dev) ---

# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=coinscan

# Secret used to sign JWT access tokens — change to a long random string
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP settings for Contact Us emails (Gmail by default)
# SMTP_USER should be your Gmail address and SMTP_PASSWORD an App Password.
# The row is ALWAYS saved to MySQL first; SMTP failure only sets emailSent=false.
# Real email delivery requires SMTP_USER + SMTP_PASSWORD (and a recipient).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=raunakbshukla133@gmail.com
# STARTTLS on/off. Default: on for ports 587/25, off otherwise (e.g. a local
# test SMTP relay on 2525). Set explicitly to override.
# SMTP_STARTTLS=true

# Google Gemini AI key — server-side only, never exposed to the browser.
# Get a FREE key at https://aistudio.google.com/apikey (free tier, no billing).
GEMINI_API_KEY=
# Free-tier model only ($0 — no credits/payment). Only models in the verified
# free allowlist are accepted (backend/ai.py _VERIFIED_FREE_GEMINI_MODELS);
# the backend refuses to start with any other model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini endpoint override (only for tests/proxies).
# GEMINI_API_URL=http://127.0.0.1:9099

# ============================================================
# PRODUCTION configuration checklist (set these when deploying;
# APP_ENV=production enforces them at startup)
# ============================================================
# APP_ENV=production                  # refuses weak/default JWT_SECRET
# JWT_SECRET=<64+ random chars>       # required, >=32 chars, not a default
# GEMINI_API_KEY=<real key>            # required in production (free-tier key)
# CORS_ORIGINS=https://your-frontend-domain.example
#   # serve the built frontend (npm run build -> dist/) over HTTPS from your
#   # web server / static host and point API calls at the backend either via
#   # the same origin reverse proxy (/api) or:
# VITE_BACKEND_URL=https://api.your-domain.example/api   # set at FRONTEND build time
# MYSQL_HOST=<db-host>  MYSQL_PORT=3306  MYSQL_USER=<user>  MYSQL_PASSWORD=<secret>
# SMTP_HOST=<smtp-host> SMTP_PORT=465|587 SMTP_USER=<user> SMTP_PASSWORD=<secret>
# CONTACT_TO=<inbox@example.com>  SMTP_STARTTLS=true
# HTTPS is terminated by your reverse proxy / hosting platform; this app
# itself only needs the above env vars (it makes no localhost assumptions).
# ============================================================
