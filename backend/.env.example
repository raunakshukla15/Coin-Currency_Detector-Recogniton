# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=coinscan

# Secret used to sign JWT access tokens — change to a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP settings for Contact Us emails (Gmail by default)
# SMTP_USER should be your Gmail address and SMTP_PASSWORD an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=raunakbshukla133@gmail.com