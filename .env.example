# Copy this file to `.env` and fill in a fresh key.
# Get a new key at https://openrouter.ai/keys (the old one in git history is revoked).
VITE_OPENROUTER_API_KEY=sk-or-v1-PASTE-YOUR-NEW-KEY-HERE

# Optional: backend base URL (defaults to /api via Vite proxy in dev)
# VITE_BACKEND_URL=http://localhost:8000
